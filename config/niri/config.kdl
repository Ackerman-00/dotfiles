// ═══════════════════════════════════════════════════════════════════
//  NIRI CONFIG · niri 26.04 · HDMI-A-1 · noctalia shell · kitty
//  Validate with:  niri validate
//  Docs:  https://niri-wm.github.io/niri/Configuration:-Introduction
// ───────────────────────────────────────────────────────────────────
//  Contents
//    1. Input          5. Startup        9.  Window rules
//    2. Output         6. Environment    10. Blur
//    3. Layout         7. Animations     11. Layer rules
//    4. Overview       8. Cursor         12. Keybinds (+ noctalia include)
// ═══════════════════════════════════════════════════════════════════


// ── 1. Input ─────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"
}


// ── 2. Output ────────────────────────────────────────────────────
output "HDMI-A-1" {
    mode "1366x768@60"
    scale 1
    transform "normal"
    variable-refresh-rate // valueless flag: presence enables it
    position x=0 y=0
}


// ── 3. Layout ────────────────────────────────────────────────────
layout {
    gaps 5
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    background-color "transparent"

    default-column-width { proportion 0.66667; }

    border {
        width 2.4
        active-gradient from="#7C86FF" to="#A684FF" angle=90
        inactive-color "#04404A"
    }

    struts {
        left 2
        right 2
        top 2
        bottom 2
    }
}


// ── 4. Overview ──────────────────────────────────────────────────
overview {
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup
    // Mod+Shift+Slash { show-hotkey-overlay; }
}


// ── 5. Startup ───────────────────────────────────────────────────
spawn-sh-at-startup "noctalia"
// spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"


// ── 6. Environment ───────────────────────────────────────────────
environment {
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_QPA_PLATFORMTHEME "qt6ct"
    EGL_PLATFORM "wayland"
    _JAVA_AWT_WM_NONREPARENTING "1"
    GTK_IM_MODULE "simple"
    TERM "kitty"
    TERMINAL "kitty"
}
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// ── 7. Animations · Umbriel shader ports ─────────────────────────
// holes-in  → window-open · holes-out → window-close · squash → resize.
animations {
    slowdown 0.8

    // · Window open · (holes-in.glsl) ·
    window-open {
        duration-ms 600
        curve "linear"
        custom-shader r"
            vec2 hole_random(vec2 cell) {
                vec2 seed = vec2(
                    dot(cell, vec2(127.1, 311.7)),
                    dot(cell, vec2(269.5, 183.3))
                );
                return fract(sin(seed) * 43758.5453123);
            }
            float hole_mask(vec2 uv, vec2 win_size, float visible) {
                float spacing = 72.0;
                float jitter = 0.70;
                vec2 logical = (uv - 0.5) * max(win_size, vec2(1.0));
                vec2 point = logical / spacing;
                vec2 base = floor(point);
                vec2 local = fract(point);
                float feather = 1.35 / spacing;
                float mask = 1.0;
                for (int y = -1; y <= 1; y++) {
                    for (int x = -1; x <= 1; x++) {
                        vec2 offset = vec2(float(x), float(y));
                        vec2 id = base + offset;
                        vec2 random_value = hole_random(id);
                        vec2 center = offset + 0.5 + (random_value - 0.5) * jitter;
                        float close_start = 0.02 + 0.12 * random_value.x;
                        float close_end = 0.72 + 0.22 * random_value.y;
                        float closed = smoothstep(close_start, close_end, visible);
                        closed = pow(closed, 0.55);
                        float size_seed = fract(random_value.x * 17.0 + random_value.y * 29.0);
                        float size_curve = mix(0.45, 2.20, size_seed);
                        float hole_open = pow(1.0 - closed, size_curve);
                        float radius = mix(-feather, 1.30, hole_open);
                        float outside = smoothstep(radius - feather, radius + feather, length(local - center));
                        mask = min(mask, outside);
                    }
                }
                return mask;
            }
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float visible = clamp(niri_clamped_progress, 0.0, 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * hole_mask(coords_geo.xy, size_geo.xy, visible);
            }
        "
    }

    // · Window close · (holes-out.glsl) ·
    window-close {
        duration-ms 500
        curve "linear"
        custom-shader r"
            vec2 hole_random(vec2 cell) {
                vec2 seed = vec2(
                    dot(cell, vec2(127.1, 311.7)),
                    dot(cell, vec2(269.5, 183.3))
                );
                return fract(sin(seed) * 43758.5453123);
            }
            float hole_mask(vec2 uv, vec2 win_size, float visible) {
                float spacing = 72.0;
                float jitter = 0.70;
                vec2 logical = (uv - 0.5) * max(win_size, vec2(1.0));
                vec2 point = logical / spacing;
                vec2 base = floor(point);
                vec2 local = fract(point);
                float feather = 1.35 / spacing;
                float mask = 1.0;
                for (int y = -1; y <= 1; y++) {
                    for (int x = -1; x <= 1; x++) {
                        vec2 offset = vec2(float(x), float(y));
                        vec2 id = base + offset;
                        vec2 random_value = hole_random(id);
                        vec2 center = offset + 0.5 + (random_value - 0.5) * jitter;
                        float close_start = 0.02 + 0.12 * random_value.x;
                        float close_end = 0.72 + 0.22 * random_value.y;
                        float closed = smoothstep(close_start, close_end, visible);
                        closed = pow(closed, 0.55);
                        float size_seed = fract(random_value.x * 17.0 + random_value.y * 29.0);
                        float size_curve = mix(0.45, 2.20, size_seed);
                        float hole_open = pow(1.0 - closed, size_curve);
                        float radius = mix(-feather, 1.30, hole_open);
                        float outside = smoothstep(radius - feather, radius + feather, length(local - center));
                        mask = min(mask, outside);
                    }
                }
                return mask;
            }
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float visible = 1.0 - clamp(niri_clamped_progress, 0.0, 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * hole_mask(coords_geo.xy, size_geo.xy, visible);
            }
        "
    }

    // · Window resize · (squash.glsl: 2% X / 4.5% Y pulse) ·
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                float p = niri_clamped_progress;
                float pulse = 16.0 * p * p * (1.0 - p) * (1.0 - p);
                vec2 scale = vec2(1.0 - 0.02 * pulse, 1.0 - 0.045 * pulse);
                vec3 squashed = vec3((coords_curr_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                vec3 coords_tex_next = niri_geo_to_tex_next * squashed;
                return texture2D(niri_tex_next, coords_tex_next.st);
            }
        "
    }

    // · Alternative: reveal wipe (Umbriel reveal.glsl) — swap in to
    //   replace the holes open/close above. ·
    // window-open {
    //     duration-ms 300
    //     curve "ease-out-expo"
    //     custom-shader r"
    //         vec4 open_color(vec3 coords_geo, vec3 size_geo) {
    //             float edge = mix(-0.02, 1.02, niri_clamped_progress);
    //             float mask = 1.0 - smoothstep(edge - 0.02, edge + 0.02, coords_geo.x);
    //             vec3 coords_tex = niri_geo_to_tex * coords_geo;
    //             vec4 color = texture2D(niri_tex, coords_tex.st);
    //             return color * mask;
    //         }
    //     "
    // }
    // window-close {
    //     duration-ms 250
    //     curve "ease-out-quad"
    //     custom-shader r"
    //         vec4 close_color(vec3 coords_geo, vec3 size_geo) {
    //             float visible = 1.0 - niri_clamped_progress;
    //             float edge = mix(-0.02, 1.02, visible);
    //             float mask = 1.0 - smoothstep(edge - 0.02, edge + 0.02, coords_geo.x);
    //             vec3 coords_tex = niri_geo_to_tex * coords_geo;
    //             vec4 color = texture2D(niri_tex, coords_tex.st);
    //             return color * mask;
    //         }
    //     "
    // }
}


// ── 8. Cursor ────────────────────────────────────────────────────
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    hide-when-typing
    hide-after-inactive-ms 3000
}


// ── 9. Window rules ──────────────────────────────────────────────
// · Global look: translucent + xray blur ·
window-rule {
    opacity 0.86
    draw-border-with-background false
    background-effect {
        blur true
        xray true
        saturation 1.50
    }
}

// · Opaque apps (no blur) ·
window-rule {
    match app-id="^blender$"
    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

window-rule {
    match app-id="^brave-browser$"
    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

// · Settings-style apps & viewers: always floating ·
window-rule {
    match app-id="^nwg-look$"
    match app-id="Loupe$"
    match app-id="^mpv$"
    match app-id="^qt6ct$"
    match app-id="^kvantummanager$"
    open-floating true
}

// · Rounded corners everywhere ·
window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
}


// ── 10. Blur ─────────────────────────────────────────────────────
blur {
    passes 2
    offset 4.0
    noise 0.01
    saturation 1.50
}


// ── 11. Layer rules · noctalia shell ─────────────────────────────
layer-rule {
    match namespace="^noctalia-backdrop*"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-.*$"
    background-effect {
        xray false
    }
}


// ── 12. Keybinds ─────────────────────────────────────────────────
// Mod = Super on TTY · Alt in a winit (nested) window.

// · Terminal & Noctalia ·
binds {
    Mod+T { spawn "kitty"; }
    Ctrl+Alt+W { spawn-sh "noctalia msg wallpaper-random"; }
    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+A { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Z { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+X { spawn-sh "noctalia msg bar-toggle"; }
    Mod+P { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+T { spawn-sh "noctalia msg panel-toggle test"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    F5 { spawn-sh "noctalia msg volume-down"; }
    F6 { spawn-sh "noctalia msg volume-up"; }
    Mod+Q { close-window; }

    // · Focus: columns & windows ·
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // · Move: columns & windows ·
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // · Monitors ·
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // · Workspaces: switch / send column / move workspace ·
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // · Workspaces by number ·
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // · Columns: consume / expel ·
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    // · Sizing & maximize ·
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+E { spawn "nautilus"; }
    Mod+O { toggle-overview; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+C      { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // · Screenshots & session ·
    Print { screenshot-screen; }
    Mod+Shift+S { screenshot; }
    Alt+F4 { quit; }
}
