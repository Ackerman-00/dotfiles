{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "height": 20
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "title",
      "format": "╭───────────────────┤ System ├───────────────────╮"
    },
    {
      "type": "os",
      "key": "│ {icon} distro ",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "uptime",
      "key": "│ 󱫐 Uptime",
      "keyColor": "red"
    },
    {
      "type": "title",
      "format": "╰────────────────────────────────────────────────╯"
    },
    "break",


    {
      "type": "title",
      "format": "╭──────────────────┤ Software ├──────────────────╮"
    },
    {
      "type": "wm",
      "key": "│ 󱗃 WM",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "│ 󰖔 DE",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "│  Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "title",
      "format": "╰────────────────────────────────────────────────╯"
    },
    "break",


    {
      "type": "title",
      "format": "╭──────────────────┤ Hardware ├──────────────────╮"
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "format": "{1} @ {7}",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "│ 󰊴 GPU",
      "format": "{1} {2}",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│  Memory",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "│  Disk",
      "folders": "/",
      "keyColor": "magenta"
    },
    /*{
      "type": "battery",
      "key": "│  Battery",
      "keyColor": "magenta"
    },*/
    {
      "type": "title",
      "format": "╰────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
